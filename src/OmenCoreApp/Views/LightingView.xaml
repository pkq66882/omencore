<UserControl x:Class="OmenCore.Views.LightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:OmenCore.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OmenCore.Controls"
             xmlns:views="clr-namespace:OmenCore.Views"
             xmlns:utils="clr-namespace:OmenCore.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <!-- Device Card Style -->
        <Style x:Key="DeviceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Background" Value="#FF252830"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Connection Status Indicator Style -->
        <Style x:Key="ConnectionIndicator" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        
        <!-- Brand Section Header Style -->
        <Style x:Key="BrandSectionHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <ScrollViewer Style="{StaticResource SmoothScrollViewer}" Panel.ZIndex="0">
        <StackPanel Margin="0,0,0,24">

        <!-- Header with Connection Overview and Sync All -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Static loc:Strings.LightingView_RgbLightingPeripherals}" 
                           FontSize="28" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <!-- Connection Status Badges — shown for all enabled providers with status-aware color -->
                    <Border Background="#0D000000" BorderBrush="{Binding CorsairStatusBrush}" BorderThickness="1" 
                            CornerRadius="10" Padding="10,4" Margin="0,0,8,0"
                            ToolTip="{Binding CorsairStatusDetail}"
                            Visibility="{Binding IsCorsairEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Fill="{Binding CorsairStatusBrush}" Style="{StaticResource ConnectionIndicator}"/>
                            <TextBlock Text="Corsair" FontSize="11" Foreground="{Binding CorsairStatusBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0D000000" BorderBrush="{Binding LogitechStatusBrush}" BorderThickness="1" 
                            CornerRadius="10" Padding="10,4" Margin="0,0,8,0"
                            ToolTip="{Binding LogitechStatusDetail}"
                            Visibility="{Binding IsLogitechEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Fill="{Binding LogitechStatusBrush}" Style="{StaticResource ConnectionIndicator}"/>
                            <TextBlock Text="Logitech" FontSize="11" Foreground="{Binding LogitechStatusBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0D000000" BorderBrush="{Binding RazerStatusBrush}" BorderThickness="1" 
                            CornerRadius="10" Padding="10,4" Margin="0,0,8,0"
                            ToolTip="{Binding RazerStatusDetail}"
                            Visibility="{Binding IsRazerEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Fill="{Binding RazerStatusBrush}" Style="{StaticResource ConnectionIndicator}"/>
                            <TextBlock Text="Razer" FontSize="11" Foreground="{Binding RazerStatusBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1AE6002E" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" 
                            CornerRadius="10" Padding="10,4"
                            Visibility="{Binding IsKeyboardLightingAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Fill="{StaticResource AccentBrush}" Style="{StaticResource ConnectionIndicator}"/>
                            <TextBlock Text="{x:Static loc:Strings.LightingView_OmenKeyboard}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Background="#14000000"
                        BorderBrush="{Binding LastRgbSyncBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,12,24,0"
                        ToolTip="{Binding LastRgbSyncDetail}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource StatusVisualBadge}"
                                Tag="{Binding LastRgbSyncVisualState}"
                                Padding="6,2"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource StatusVisualGlyph}" Tag="{Binding LastRgbSyncVisualState}" Width="10" Height="10" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding LastRgbSyncVisualLabel}" Style="{StaticResource StatusVisualText}" Tag="{Binding LastRgbSyncVisualState}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding LastRgbSyncSummary}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LastRgbSyncDetail}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2"
                                Background="#0DFFFFFF"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding RgbSyncParticipantSummary}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Background="#10131A"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,12"
                        Margin="0,10,24,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Static loc:Strings.LightingView_ControlOwnership}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Style="{StaticResource StatusVisualBadge}"
                                        Tag="{Binding RgbOwnershipVisualState}"
                                        Padding="6,2"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource StatusVisualGlyph}" Tag="{Binding RgbOwnershipVisualState}" Width="10" Height="10" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding RgbOwnershipVisualLabel}" Style="{StaticResource StatusVisualText}" Tag="{Binding RgbOwnershipVisualState}"/>
                                    </StackPanel>
                                </Border>
                                <Border
                                    Background="#141A22"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3">
                                    <TextBlock Text="{Binding HpKeyboardActiveBackend, StringFormat={x:Static loc:Strings.LightingView_HpBackendFormat}}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding RgbOwnershipSummary}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>

                        <!-- Windows Dynamic Lighting owns HP's four-zone virtual lamp device. Blue, not
                             amber: it's another feature's setting, not a fault in ours. -->
                        <Border Background="#2230A0E0" BorderBrush="#30A0E0" BorderThickness="1" CornerRadius="6"
                                Padding="10" Margin="0,10,0,0"
                                Visibility="{Binding HasKeyboardDynamicLightingWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding KeyboardDynamicLightingWarning}" FontSize="11" Foreground="#8CC8F0"
                                           TextWrapping="Wrap"/>
                                <Button Content="{x:Static loc:Strings.KeyboardMapEditor_OpenDynamicLightingSettings}"
                                        Command="{Binding OpenDynamicLightingSettingsCommand}"
                                        Style="{StaticResource ModernButton}" Padding="12,4" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" FontSize="11"
                                        AutomationProperties.Name="{x:Static loc:Strings.KeyboardMapEditor_OpenTheWindowsDynamicLightingSettingsPage}"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding KeyboardRestoreStatusText}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Button Grid.Column="1"
                                    Command="{Binding RestoreKeyboardLightingCommand}"
                                    IsEnabled="{Binding IsKeyboardLightingAvailable}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5"
                                    ToolTip="{x:Static loc:Strings.LightingView_ReapplySavedKeyboardColorsThroughTheActive}"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_RestoreKeyboardLighting}">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_RestoreKeyboard}"
                                           FontSize="10"/>
                            </Button>
                        </Grid>

                        <Border Background="#0DFFFFFF"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.LightingView_RgbSurfaceObservation}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding RgbSurfaceObservationStatusText}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding RgbObservedSurfaceOptions}"
                                          SelectedItem="{Binding SelectedObservedRgbSurface, Mode=TwoWay}"
                                          MinHeight="30"
                                          VerticalAlignment="Center"
                                          ToolTip="{x:Static loc:Strings.LightingView_RecordThePhysicalRgbOrBacklightSurfaceThat}"
                                          AutomationProperties.Name="{x:Static loc:Strings.LightingView_ObservedRgbSurface}"/>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <Button Command="{Binding RunRgbSurfaceProbeCommand}"
                                            IsEnabled="{Binding IsKeyboardLightingAvailable}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="8,5"
                                            Margin="0,0,6,0"
                                            ToolTip="{x:Static loc:Strings.LightingView_ApplyASafeBrightProbeColorThroughTheActive}"
                                            AutomationProperties.Name="{x:Static loc:Strings.LightingView_RunRgbSurfaceProbe}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconRefresh}"
                                                  Width="12"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,5,0"/>
                                            <TextBlock Text="{x:Static loc:Strings.LightingView_Probe}" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SaveRgbSurfaceObservationCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="8,5"
                                            ToolTip="{x:Static loc:Strings.LightingView_SaveTheSelectedObservedRgbSurfaceForDiagno}"
                                            AutomationProperties.Name="{x:Static loc:Strings.LightingView_SaveObservedRgbSurface}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCheck}"
                                                  Width="12"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,5,0"/>
                                            <TextBlock Text="{x:Static loc:Strings.FanControlView_Save}" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#26FFB300"
                                BorderBrush="#FFFFB300"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,10,0,0"
                                Visibility="{Binding HasRgbConflictWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding RgbConflictWarningText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFD166"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding CorsairStatusDetail}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CorsairStatusDetail}"
                                       Margin="0,0,8,0"
                                       Visibility="{Binding IsCorsairEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LogitechStatusDetail}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LogitechStatusDetail}"
                                       Margin="0,0,8,0"
                                       Visibility="{Binding IsLogitechEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding RazerStatusDetail}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RazerStatusDetail}"
                                       Visibility="{Binding IsRazerEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- Sync All Button -->
            <Button Grid.Column="1" Command="{Binding SyncAllRgbCommand}"
                    VerticalAlignment="Top" Margin="0,0,0,0"
                    ToolTip="{x:Static loc:Strings.LightingView_SyncCurrentColorAcrossAllConnectedRgbDevic}"
                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_SyncAllRgbDevices}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="20,12"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔗" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Static loc:Strings.LightingView_SyncAllRgb}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FF005C"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#CC0025"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>


                <!-- Scene Quick Select Section -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16"
                        Visibility="{Binding IsSceneServiceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🎨" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static loc:Strings.LightingView_SceneQuickSelect}" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <!-- Was a stray hardcoded purple (#9C27B0) matching nothing else in the app's
                                 palette. AccentBrush is already what "active/selected" means everywhere
                                 else here (the nav rail's selection bar, the Quick Profiles ACTIVE pill). -->
                            <Border Background="#1AFF005C" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSceneName, StringFormat={x:Static loc:Strings.LightingView_ActiveFormat}}" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <ToggleButton IsChecked="{Binding SceneQuickSelectCardEnabled, Mode=TwoWay}"
                                          Style="{StaticResource ToggleButtonStyle}"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          ToolTip="{x:Static loc:Strings.LightingView_EnableOrDisableSceneQuickSelectControlsInT}"
                                          AutomationProperties.Name="{x:Static loc:Strings.LightingView_EnableSceneQuickSelectCard}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsSceneQuickSelectCardContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        
                        <!-- Scene Grid -->
                        <ItemsControl ItemsSource="{Binding Scenes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8" Padding="12,8"
                                            Command="{Binding DataContext.ApplySceneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Description}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceMediumBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <!-- Color swatch: RgbScene.PrimaryColor already carries this, it was
                                                                         just never rendered - every scene button read identically grey
                                                                         regardless of what color it actually applies. -->
                                                                    <Ellipse Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                             Fill="{Binding PrimaryColor, Converter={StaticResource HexToBrushConverter}}"
                                                                             Stroke="#33000000" StrokeThickness="1"/>
                                                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Name, Converter={StaticResource SceneDisplayName}}" FontSize="12" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="border" Property="Background" Value="#1AE6002E"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Ambient Mode Toggle -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.LightingView_AmbientScreenLighting}" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.LightingView_RgbSyncsWithScreenEdgeColors}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding IsAmbientModeActive, Mode=TwoWay}"
                                          Style="{StaticResource ToggleButtonStyle}"
                                          AutomationProperties.Name="{x:Static loc:Strings.LightingView_AmbientScreenLighting}"/>
                        </Grid>

                        <!-- Audio Reactive Toggle -->
                        <Grid Margin="0,12,0,0"
                              Visibility="{Binding IsAudioReactiveModeAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.LightingView_AudioReactiveLighting}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.LightingView_PulsesWithSystemAudioOutputViaWasapiLoopba}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding AudioReactiveLevelText}" FontSize="11"
                                           Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding IsAudioReactiveModeActive, Mode=TwoWay}"
                                          Style="{StaticResource ToggleButtonStyle}"
                                          AutomationProperties.Name="{x:Static loc:Strings.LightingView_AudioReactiveLighting}"/>
                        </Grid>

                        <Grid Margin="0,8,0,0"
                              Visibility="{Binding IsAudioReactiveModeAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.LightingView_Mode}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AudioVisualizationModes}"
                                      SelectedItem="{Binding SelectedAudioVisualizationMode, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBox}"
                                      AutomationProperties.Name="{x:Static loc:Strings.LightingView_AudioReactiveVisualizationMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource AudioVizModeDisplay}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Column="3" Text="{x:Static loc:Strings.LightingView_Sensitivity}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <Slider Grid.Column="4" Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding AudioReactiveSensitivity, Mode=TwoWay}"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_AudioReactiveSensitivity}"/>
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Corsair Devices Section -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Brand Header with Logo -->
                        <StackPanel Style="{StaticResource BrandSectionHeader}">
                            <Image Source="pack://application:,,,/Assets/corsair.png" Width="28" Height="28" Margin="0,0,12,0"/>
                            <TextBlock Text="{x:Static loc:Strings.LightingView_CorsairDevices}" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="#0D000000" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center"
                                    BorderBrush="{Binding CorsairStatusBrush}" BorderThickness="1"
                                    ToolTip="{Binding CorsairStatusDetail}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Fill="{Binding CorsairStatusBrush}" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding CorsairStatusDetail}" FontSize="10" Foreground="{Binding CorsairStatusBrush}"/>
                                </StackPanel>
                            </Border>
                            <ToggleButton IsChecked="{Binding CorsairCardEnabled, Mode=TwoWay}"
                                          Style="{StaticResource ToggleButtonStyle}"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          ToolTip="{x:Static loc:Strings.LightingView_EnableOrDisableCorsairControlsInThisCard}"
                                          AutomationProperties.Name="{x:Static loc:Strings.LightingView_EnableCorsairDevicesCard}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsCorsairCardContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        
                        <!-- Device Discovery -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding CorsairDeviceStatusText}" 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            
                            <Button Grid.Column="1" 
                                    Content="{x:Static loc:Strings.LightingView_DiscoverDevices}" 
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding DiscoverCorsairDevicesCommand}"
                                    Padding="16,8"/>
                        </Grid>

                        <!-- Corsair Device List -->
                        <ItemsControl ItemsSource="{Binding CorsairDevices}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DeviceCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Device Icon -->
                                            <Border Grid.Column="0" Width="48" Height="48" 
                                                    Background="{StaticResource SurfaceMediumBrush}"
                                                    CornerRadius="24" Margin="0,0,16,0">
                                                <Image Source="pack://application:,,,/Assets/corsair.png" 
                                                       Width="32" Height="32" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Device Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding DeviceType, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Border Background="#1A4CAF50" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Status, Mode=OneWay}" FontSize="10" Foreground="#4CAF50"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Identify Button -->
                                            <Button Grid.Column="2" 
                                                    Content="{x:Static loc:Strings.LightingView_Identify}"
                                                    Style="{StaticResource ModernButton}"
                                                    Command="{Binding DataContext.FlashCorsairDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{x:Static loc:Strings.LightingView_FlashDeviceLedsToIdentifyThisDevice}"
                                                    Padding="12,6"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"/>

                                            <!-- DPI Info (for mice) -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0"
                                                        Visibility="{Binding IsMouse, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="DPI" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding CurrentDpi}" 
                                                           Style="{StaticResource MonospaceValue}"
                                                           FontSize="16" Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Corsair Lighting Presets -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.LightingView_LightingPreset}" 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            
                            <ComboBox Grid.Column="1" 
                                      Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding CorsairLightingPresets}"
                                      SelectedItem="{Binding SelectedCorsairLightingPreset}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,12,0"/>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{x:Static loc:Strings.AdvancedView_Apply}" Style="{StaticResource ModernButton}" Command="{Binding ApplyCorsairLightingCommand}" Padding="16,8" Margin="0,0,8,0"/>
                                <Button Content="{x:Static loc:Strings.LightingView_ApplyToSystem}" Style="{StaticResource ModernButton}" Command="{Binding ApplyCorsairPresetToSystemCommand}" Padding="12,8"/>
                            </StackPanel>
                        </Grid>

                        <!-- Custom RGB Color with Color Picker -->
                        <Expander Header="{x:Static loc:Strings.LightingView_CustomRgbColor}" 
                                  Margin="0,16,0,0"
                                  IsExpanded="False">
                            <StackPanel Margin="0,12,0,0">
                                <controls:ColorPickerControl HexValue="{Binding CorsairColorHex, Mode=TwoWay}" 
                                                             Margin="0,0,0,16"/>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.LightingView_ColorHex}" 
                                               FontSize="14" 
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    
                                    <TextBox Grid.Column="1" 
                                             Style="{StaticResource ModernTextBox}"
                                             Text="{Binding CorsairColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,12,0"
                                             MaxLength="7"/>
                                    
                                    <Button Grid.Column="2" 
                                            Content="{x:Static loc:Strings.LightingView_ApplyColor}" 
                                            Style="{StaticResource ModernButton}"
                                            Command="{Binding ApplyCorsairCustomColorCommand}"
                                            Padding="16,8"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- DPI Configuration (for mice) -->
                        <Expander Header="{x:Static loc:Strings.LightingView_DpiConfiguration}" 
                                  Margin="0,16,0,0"
                                  IsExpanded="False"
                                  Visibility="{Binding HasCorsairMouse, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_DpiStages}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                           Margin="0,0,0,8"/>
                                
                                <ItemsControl ItemsSource="{Binding CorsairDpiStages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding Name, StringFormat={}{0}:}" 
                                                           FontSize="12" 
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" 
                                                           Width="60"/>
                                                
                                                <Slider Grid.Column="1"
                                                        Minimum="400" Maximum="18000"
                                                        TickFrequency="100"
                                                        Value="{Binding Dpi}"
                                                        Margin="12,0"
                                                        AutomationProperties.Name="{Binding Name, StringFormat={}{0} DPI stage}"/>
                                                
                                                <TextBlock Grid.Column="2" 
                                                           Text="{Binding Dpi, StringFormat={}{0} DPI}" 
                                                           FontSize="12" 
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" 
                                                           Width="80" TextAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                        <ComboBox Style="{StaticResource ModernComboBox}"
                                                  ItemsSource="{Binding CorsairDpiProfiles}"
                                                  SelectedItem="{Binding SelectedCorsairDpiProfile}"
                                                  DisplayMemberPath="Name"
                                                  Width="220" Margin="0,0,8,0"
                                                  ToolTip="{x:Static loc:Strings.LightingView_SelectASavedDpiProfileSaveWithSameNameWill}"
                                                  AutomationProperties.Name="{x:Static loc:Strings.LightingView_SavedDpiProfileSelection}"/>

                                        <Button Content="{x:Static loc:Strings.LightingView_SaveProfile}" Style="{StaticResource ModernButton}" Command="{Binding SaveCorsairDpiProfileCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="{x:Static loc:Strings.LightingView_SaveCurrentDpiStagesAsAProfile}"/>
                                        <Button Content="{x:Static loc:Strings.LightingView_ApplyProfile}" Style="{StaticResource ModernButton}" Command="{Binding ApplyCorsairDpiProfileCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="{x:Static loc:Strings.LightingView_ApplySelectedDpiProfileToCurrentStages}"/>
                                        <Button Content="{x:Static loc:Strings.GameProfileManagerView_Delete}" Style="{StaticResource ModernButton}" Command="{Binding DeleteCorsairDpiProfileCommand}" Padding="12,6" ToolTip="{x:Static loc:Strings.LightingView_DeleteTheSelectedDpiProfile}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                                        <Button Content="{x:Static loc:Strings.LightingView_RestoreDefaults}" 
                                                Style="{StaticResource ModernButton}"
                                                Command="{Binding RestoreCorsairDpiCommand}"
                                                Padding="12,6" Margin="0,0,8,0"/>
                                        <Button Content="{x:Static loc:Strings.LightingView_ApplyDpiSettings}" 
                                                Style="{StaticResource ModernButton}"
                                                Command="{Binding ApplyCorsairDpiCommand}"
                                                Padding="16,8" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Logitech Devices Section -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Brand Header with Logo -->
                        <StackPanel Style="{StaticResource BrandSectionHeader}">
                            <Image Source="pack://application:,,,/Assets/logitechg.png" Width="28" Height="28" Margin="0,0,12,0"/>
                            <TextBlock Text="{x:Static loc:Strings.LightingView_LogitechDevices}" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="#0D000000" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center"
                                    BorderBrush="{Binding LogitechStatusBrush}" BorderThickness="1"
                                    ToolTip="{Binding LogitechStatusDetail}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Fill="{Binding LogitechStatusBrush}" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding LogitechStatusDetail}" FontSize="10" Foreground="{Binding LogitechStatusBrush}"/>
                                </StackPanel>
                            </Border>
                            <ToggleButton IsChecked="{Binding LogitechCardEnabled, Mode=TwoWay}"
                                          Style="{StaticResource ToggleButtonStyle}"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          ToolTip="{x:Static loc:Strings.LightingView_EnableOrDisableLogitechControlsInThisCard}"
                                          AutomationProperties.Name="{x:Static loc:Strings.LightingView_EnableLogitechDevicesCard}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsLogitechCardContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <!-- System RGB Section -->
                        <Border Background="{StaticResource SurfaceDarkBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.LightingView_ApplyToAllSystemRgb}" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{x:Static loc:Strings.LightingView_SyncColorAcrossAllDetectedLogitechDevices}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:ColorPickerControl HexValue="{Binding SystemColorHex, Mode=TwoWay}" Width="220"/>
                                    <Button Content="{x:Static loc:Strings.LightingView_ApplyToSystem}" Style="{StaticResource ModernButton}" Command="{Binding ApplyToSystemCommand}" Padding="16,8" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Device Discovery -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding LogitechDeviceStatusText}" 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            
                            <Button Grid.Column="1" 
                                    Content="{x:Static loc:Strings.LightingView_DiscoverDevices}" 
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding DiscoverLogitechDevicesCommand}"
                                    Padding="16,8"/>
                        </Grid>

                        <!-- Logitech Device List -->
                        <ItemsControl ItemsSource="{Binding LogitechDevices}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DeviceCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Device Icon -->
                                            <Border Grid.Column="0" Width="48" Height="48" 
                                                    Background="{StaticResource SurfaceMediumBrush}"
                                                    CornerRadius="24" Margin="0,0,16,0">
                                                <Image Source="pack://application:,,,/Assets/logitechg.png" 
                                                       Width="32" Height="32" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Device Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding DeviceType, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Border Background="#1A45C7FF" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Status, Mode=OneWay}" FontSize="10" Foreground="#45C7FF"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Color Preview -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="36" Height="36" 
                                                        Background="{Binding CurrentColor}" 
                                                        BorderBrush="{StaticResource BorderBrush}" 
                                                        BorderThickness="2" 
                                                        CornerRadius="8"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Logitech Static Color -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.LightingView_StaticColor}" 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_Red}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding LogitechRedValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14"
                                         AutomationProperties.Name="{x:Static loc:Strings.LightingView_LogitechColorRedValue}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_Green}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding LogitechGreenValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14"
                                         AutomationProperties.Name="{x:Static loc:Strings.LightingView_LogitechColorGreenValue}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_Blue}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding LogitechBlueValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14"
                                         AutomationProperties.Name="{x:Static loc:Strings.LightingView_LogitechColorBlueValue}"/>
                            </StackPanel>
                            
                            <Button Grid.Column="5" 
                                    Content="{x:Static loc:Strings.LightingView_ApplyColor}" 
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding ApplyLogitechColorCommand}"
                                    Padding="16,8" 
                                    VerticalAlignment="Bottom"/>
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Razer Devices Section -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Brand Header with Logo -->
                        <StackPanel Style="{StaticResource BrandSectionHeader}">
                            <Border Width="28" Height="28" Background="#1A44D62C" CornerRadius="6" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconRazer}" Fill="#44D62C" Stretch="Uniform"
                                      Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{x:Static loc:Strings.LightingView_RazerDevices}" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="#0D000000" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center"
                                    BorderBrush="{Binding RazerStatusBrush}" BorderThickness="1"
                                    ToolTip="{Binding RazerStatusDetail}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Fill="{Binding RazerStatusBrush}" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding RazerStatusDetail}" FontSize="10" Foreground="{Binding RazerStatusBrush}"/>
                                </StackPanel>
                            </Border>
                            <ToggleButton IsChecked="{Binding RazerCardEnabled, Mode=TwoWay}"
                                          Style="{StaticResource ToggleButtonStyle}"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          ToolTip="{x:Static loc:Strings.LightingView_EnableOrDisableRazerControlsInThisCard}"
                                          AutomationProperties.Name="{x:Static loc:Strings.LightingView_EnableRazerDevicesCard}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsRazerCardContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        
                        <TextBlock Text="{x:Static loc:Strings.LightingView_RequiresRazerSynapseToBeInstalledAndRunnin}" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,16"/>
                        
                        <!-- Device Discovery -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding RazerDeviceStatusText}" 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            
                            <Button Grid.Column="1" 
                                    Content="{x:Static loc:Strings.LightingView_DiscoverDevices}" 
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding DiscoverRazerDevicesCommand}"
                                    Padding="16,8"/>
                        </Grid>

                        <!-- Razer Device List -->
                        <ItemsControl ItemsSource="{Binding RazerDevices}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DeviceCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Razer Icon -->
                                            <Border Grid.Column="0" Width="48" Height="48"
                                                    Background="#1A44D62C" CornerRadius="24" Margin="0,0,16,0">
                                                <Path Data="{StaticResource IconRazer}" Fill="#44D62C" Stretch="Uniform"
                                                      Width="30" Height="30"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Device Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding DeviceType, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Border Background="#1A44D62C" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Status, Mode=OneWay}" FontSize="10" Foreground="#44D62C"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Razer Static Color -->
                        <TextBlock Text="{x:Static loc:Strings.LightingView_LightingControl}" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.LightingView_Color}" 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_Red}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RazerRedValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14"
                                         AutomationProperties.Name="{x:Static loc:Strings.LightingView_RazerColorRedValue}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_Green}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RazerGreenValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14"
                                         AutomationProperties.Name="{x:Static loc:Strings.LightingView_RazerColorGreenValue}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_Blue}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RazerBlueValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14"
                                         AutomationProperties.Name="{x:Static loc:Strings.LightingView_RazerColorBlueValue}"/>
                            </StackPanel>
                            
                            <Button Grid.Column="5" 
                                    Content="{x:Static loc:Strings.LightingView_ApplyStatic}" 
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding ApplyRazerColorCommand}"
                                    Padding="16,8" 
                                    VerticalAlignment="Bottom"/>
                        </Grid>
                        
                        <!-- Razer Effects -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" 
                                    Content="{x:Static loc:Strings.LightingView_Breathing}" 
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding ApplyRazerBreathingCommand}"
                                    Padding="16,8" 
                                    Margin="0,0,8,0"/>
                            
                            <Button Grid.Column="1" 
                                    Content="{x:Static loc:Strings.LightingView_SpectrumCycle}" 
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding ApplyRazerSpectrumCommand}"
                                    Padding="16,8"/>
                        </Grid>
                        
                        <!-- Note about limited Razer support -->
                        <Border Background="{StaticResource SurfaceDarkBrush}" CornerRadius="4" 
                                Padding="12" Margin="0,16,0,0">
                            <TextBlock Text="{x:Static loc:Strings.LightingView_RazerSupportIsLimitedToDetectedDeviceStatu}" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- OpenRGB Devices Section (Desktop RGB Support) -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16"
                        Visibility="{Binding HasOpenRgbDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Brand Header with Logo -->
                        <StackPanel Style="{StaticResource BrandSectionHeader}">
                            <Border Width="28" Height="28" Background="#FF6B35" CornerRadius="6" Margin="0,0,12,0">
                                <TextBlock Text="🌈" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{x:Static loc:Strings.LightingView_OpenrgbDevices}" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="#1AFF6B35" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OpenRgbStatusText}" FontSize="10" Foreground="#FF6B35"/>
                            </Border>
                        </StackPanel>
                        
                        <TextBlock Text="{x:Static loc:Strings.LightingView_OptionalGenericRgbControlViaOpenrgbServerF}"
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,16"/>
                        
                        <!-- OpenRGB Device List -->
                        <ItemsControl ItemsSource="{Binding OpenRgbDevices}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DeviceCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Device Icon -->
                                            <Border Grid.Column="0" Width="48" Height="48" 
                                                    Background="#FF6B35" CornerRadius="24" Margin="0,0,16,0">
                                                <TextBlock Text="💡" FontSize="18"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Device Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding Type, Mode=OneWay}"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding Vendor, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <!-- LED Count -->
                                            <Border Grid.Column="2" Background="#1AFF6B35" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock FontSize="11" Foreground="#FF6B35">
                                                    <Run Text="{Binding LedCount, Mode=OneWay}"/>
                                                    <Run Text="{x:Static loc:Strings.LightingView_Leds}"/>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Quick Color Buttons for OpenRGB -->
                        <TextBlock Text="{x:Static loc:Strings.LightingView_QuickColors}" 
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiaryBrush}" 
                                   Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,0">
                            <Button Content="🔴" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Red}"
                                    Command="{Binding ApplyOpenRgbColorCommand}" CommandParameter="#FF0000"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_OpenrgbQuickColorRed}"/>
                            <Button Content="🔵" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Blue}"
                                    Command="{Binding ApplyOpenRgbColorCommand}" CommandParameter="#0066FF"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_OpenrgbQuickColorBlue}"/>
                            <Button Content="🟢" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Green}"
                                    Command="{Binding ApplyOpenRgbColorCommand}" CommandParameter="#00FF00"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_OpenrgbQuickColorGreen}"/>
                            <Button Content="🟣" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Purple}"
                                    Command="{Binding ApplyOpenRgbColorCommand}" CommandParameter="#9400D3"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_OpenrgbQuickColorPurple}"/>
                            <Button Content="🟡" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Yellow}"
                                    Command="{Binding ApplyOpenRgbColorCommand}" CommandParameter="#FFFF00"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_OpenrgbQuickColorYellow}"/>
                            <Button Content="⚪" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_White}"
                                    Command="{Binding ApplyOpenRgbColorCommand}" CommandParameter="#FFFFFF"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_OpenrgbQuickColorWhite}"/>
                            <Button Content="🟠" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Orange}"
                                    Command="{Binding ApplyOpenRgbColorCommand}" CommandParameter="#FF6B35"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_OpenrgbQuickColorOrange}"/>
                            <Button Content="⬛" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Off}"
                                    Command="{Binding ApplyOpenRgbColorCommand}" CommandParameter="#000000"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_OpenrgbQuickColorOff}"/>
                        </WrapPanel>
                        
                        <!-- Info Box -->
                        <Border Background="{StaticResource SurfaceDarkBrush}" CornerRadius="4" 
                                Padding="12" Margin="0,16,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{x:Static loc:Strings.LightingView_OpenrgbIntegration}"/>
                                <Run Text="{x:Static loc:Strings.LightingView_ControlsAnyRgbDeviceSupportedByOpenrgbMoth}"/>
                                <Run Text="{x:Static loc:Strings.LightingView_DownloadOpenrgbFromOpenrgbOrgAndEnableTheS}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- HP OMEN Keyboard Lighting -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16"
                        Visibility="{Binding IsKeyboardLightingAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Brand Header with Icon -->
                        <StackPanel Style="{StaticResource BrandSectionHeader}">
                            <Border Width="28" Height="28" Background="{StaticResource AccentBrush}" CornerRadius="6" Margin="0,0,12,0">
                                <TextBlock Text="⌨️" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{x:Static loc:Strings.LightingView_HpOmenKeyboard}" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="#1AE6002E" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding KeyboardLightingBackend}" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <ToggleButton IsChecked="{Binding HpOmenKeyboardCardEnabled, Mode=TwoWay}"
                                          Style="{StaticResource ToggleButtonStyle}"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          ToolTip="{x:Static loc:Strings.LightingView_EnableOrDisableHpOmenKeyboardControlsInThi}"
                                          AutomationProperties.Name="{x:Static loc:Strings.LightingView_EnableHpOmenKeyboardCard}"/>
                        </StackPanel>
                        
                        <TextBlock Text="{x:Static loc:Strings.LightingView_YourLaptopSBuiltIn4ZoneRgbKeyboard}" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,12"/>

                        <StackPanel Visibility="{Binding IsHpOmenKeyboardCardContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        
                        <!-- Four-zone keyboard controls. Hidden on chassis whose capability entry says
                             there is no four-zone KEYBOARD: on a per-key machine these commands still
                             succeed, but they land on the light bar, so the editor appeared to work
                             while the keyboard never changed. The light bar has its own card now, so
                             hiding this no longer removes the only way to reach it. -->
                        <StackPanel Visibility="{Binding HasFourZoneKeyboard, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <!-- Quick Color Buttons -->
                        <TextBlock Text="{x:Static loc:Strings.LightingView_QuickColorsClickToApplyToAllZones}" 
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiaryBrush}" 
                                   Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="🔴" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_OmenRed}"
                                    Command="{Binding ApplyQuickColorCommand}" CommandParameter="#E6002E"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_KeyboardQuickColorOmenRed}"/>
                            <Button Content="🔵" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Blue}"
                                    Command="{Binding ApplyQuickColorCommand}" CommandParameter="#0066FF"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_KeyboardQuickColorBlue}"/>
                            <Button Content="🟢" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Green}"
                                    Command="{Binding ApplyQuickColorCommand}" CommandParameter="#00FF00"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_KeyboardQuickColorGreen}"/>
                            <Button Content="🟣" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Purple}"
                                    Command="{Binding ApplyQuickColorCommand}" CommandParameter="#9400D3"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_KeyboardQuickColorPurple}"/>
                            <Button Content="🟡" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Yellow}"
                                    Command="{Binding ApplyQuickColorCommand}" CommandParameter="#FFFF00"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_KeyboardQuickColorYellow}"/>
                            <Button Content="⚪" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_White}"
                                    Command="{Binding ApplyQuickColorCommand}" CommandParameter="#FFFFFF"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_KeyboardQuickColorWhite}"/>
                            <Button Content="🩵" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Cyan}"
                                    Command="{Binding ApplyQuickColorCommand}" CommandParameter="#00FFFF"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_KeyboardQuickColorCyan}"/>
                            <Button Content="🩷" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Pink}"
                                    Command="{Binding ApplyQuickColorCommand}" CommandParameter="#FF69B4"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_KeyboardQuickColorPink}"/>
                            <Button Content="⬛" FontSize="14" Padding="8,4" Margin="0,0,6,4"
                                    Style="{StaticResource ModernButton}" ToolTip="{x:Static loc:Strings.LightingView_Off}"
                                    Command="{Binding ApplyQuickColorCommand}" CommandParameter="#000000"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_KeyboardQuickColorOff}"/>
                        </WrapPanel>
                        
                        <!-- Keyboard Status Hint (shows tips for models where WMI may not work) -->
                        <Border Background="#1A8B5CF6" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                                Visibility="{Binding KeyboardLightingHint, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <TextBlock Text="{Binding KeyboardLightingHint}" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Keyboard Zone Display - Visual Schematic -->
                        <TextBlock Text="{x:Static loc:Strings.LightingView_KeyboardZonesClickZoneToChangeColor}" 
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   Margin="0,8,0,12"/>

                        <!-- Visual laptop keyboard - a synthetic standard layout (not read from any
                             device; four-zone hardware doesn't expose per-key positions the way the
                             per-key editor's measured map does), with every key tagged to the zone it
                             falls under. Click a key to open that zone's color picker. -->
                        <Border Background="#0D0D0D" CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                                BorderBrush="#333" BorderThickness="2">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <Canvas Width="{Binding FourZoneCanvasWidth}" Height="{Binding FourZoneCanvasHeight}"
                                        Background="Transparent">
                                    <ItemsControl ItemsSource="{Binding FourZoneKeys}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas IsItemsHost="True"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}" Height="{Binding Height}"
                                                        CornerRadius="4" Cursor="Hand"
                                                        BorderBrush="#3A3A3A" BorderThickness="1"
                                                        ToolTip="{Binding Label}">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SetZoneColorByIndexCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding ZoneIndex}"/>
                                                    </Border.InputBindings>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ZoneIndex}" Value="1">
                                                                    <Setter Property="Background" Value="{Binding DataContext.Zone1Brush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ZoneIndex}" Value="2">
                                                                    <Setter Property="Background" Value="{Binding DataContext.Zone2Brush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ZoneIndex}" Value="3">
                                                                    <Setter Property="Background" Value="{Binding DataContext.Zone3Brush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ZoneIndex}" Value="4">
                                                                    <Setter Property="Background" Value="{Binding DataContext.Zone4Brush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Label}" FontSize="8" FontWeight="SemiBold"
                                                               Foreground="White" Opacity="0.75"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Hex color inputs for each zone -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,2,0" HorizontalAlignment="Center">
                                <Ellipse Width="14" Height="14" Fill="{Binding Zone1Brush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Zone1ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="10" Width="70" TextAlignment="Center" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0" HorizontalAlignment="Center">
                                <Ellipse Width="14" Height="14" Fill="{Binding Zone2Brush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Zone2ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="10" Width="70" TextAlignment="Center" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="2,0" HorizontalAlignment="Center">
                                <Ellipse Width="14" Height="14" Fill="{Binding Zone3Brush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Zone3ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="10" Width="70" TextAlignment="Center" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="2,0,0,0" HorizontalAlignment="Center">
                                <Ellipse Width="14" Height="14" Fill="{Binding Zone4Brush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Zone4ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="10" Width="70" TextAlignment="Center" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>
                        
                        </StackPanel>
                        <!-- end four-zone keyboard controls -->

                        <!-- Preset Selection and Apply Buttons -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.LightingView_Preset}" 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding KeyboardPresets}"
                                      SelectedItem="{Binding SelectedKeyboardPreset}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,12,0"
                                      AutomationProperties.Name="{x:Static loc:Strings.LightingView_KeyboardLightingPresetSelection}"/>

                            <Button Grid.Column="2"
                                    Content="{x:Static loc:Strings.KeyboardMapEditor_ApplyToKeyboard}"
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding ApplyKeyboardColorsCommand}"
                                    Padding="16,8"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_ApplyZoneColorsToKeyboard}"/>
                            
                            <Button Grid.Column="3" 
                                    Content="{x:Static loc:Strings.LightingView_AllSameColor}" 
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding ApplyAllZonesSameColorCommand}"
                                    Padding="16,8"
                                    ToolTip="{x:Static loc:Strings.LightingView_ApplyZone1ColorToAllZones}"/>
                        </Grid>
                        
                        <!-- Apply on Startup Toggle -->
                        <Border Background="{StaticResource SurfaceDarkBrush}" 
                                CornerRadius="8" Padding="16" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.LightingView_ApplyColorsOnStartup}" 
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Static loc:Strings.LightingView_AutomaticallyRestoreSavedKeyboardColorsWhe}" 
                                               FontSize="11" 
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding ApplyKeyboardColorsOnStartup, Mode=TwoWay}"
                                              Style="{StaticResource ModernToggleButton}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Static loc:Strings.LightingView_ApplyKeyboardColorsOnStartup}"/>
                            </Grid>
                        </Border>

                        <!-- Per-Key Lighting Section -->
                        <Border Background="{StaticResource SurfaceDarkBrush}" CornerRadius="8"
                                Margin="0,12,0,0" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{x:Static loc:Strings.DiagnosticsView_PerKeyRgb}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border Background="#1A8B5CF6" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static loc:Strings.LightingView_OmenMax}" FontSize="10" Foreground="#8B5CF6"/>
                                    </Border>
                                </StackPanel>

                                <!-- Explanation card when per-key not available -->
                                <Border Background="#12FFFFFF" CornerRadius="6" Padding="12"
                                        Visibility="{Binding IsPerKeyLightingAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="{Binding PerKeyCapabilitySummary}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Measured-layout editor. Shown only where the backend has read a real
                                     lamp map off the device; everywhere else this is collapsed and the
                                     fixed grid below is exactly what it always was. -->
                                <StackPanel Visibility="{Binding HasMeasuredKeyMap, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{x:Static loc:Strings.LightingView_MeasuredLayoutEveryKeyAtThePositionTheKeyb}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <views:KeyboardMapEditor DataContext="{Binding KeyboardMap}"/>
                                </StackPanel>

                                <!-- Per-key editor when supported -->
                                <StackPanel Visibility="{Binding IsFixedGridEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!-- Brush color row -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.KeyboardMapEditor_Brush}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="4"
                                                Background="{Binding SelectedPerKeyColorBrush}"
                                                BorderBrush="#444" BorderThickness="1" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding SelectedPerKeyColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="7" Width="72" Margin="0,0,12,0"/>
                                        <Button Grid.Column="4" Content="{x:Static loc:Strings.LightingView_FillAll}" Style="{StaticResource ModernButton}"
                                                Command="{Binding FillAllPerKeyCommand}" Padding="12,6" Margin="0,0,8,0"/>
                                        <Button Grid.Column="5" Content="{x:Static loc:Strings.KeyboardMapEditor_ApplyToKeyboard}"
                                                Style="{StaticResource ModernButton}"
                                                Command="{Binding ApplyPerKeyLightingCommand}" Padding="16,6"
                                                AutomationProperties.Name="{x:Static loc:Strings.LightingView_ApplyPerKeyColorsToKeyboard}"/>
                                    </Grid>
                                    <!-- Key grid -->
                                    <Border Background="#0D0D0D" CornerRadius="8" Padding="8"
                                            BorderBrush="#333" BorderThickness="1.5">
                                        <ItemsControl ItemsSource="{Binding PerKeyGrid}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="6" Columns="14"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="1" CornerRadius="3" Height="28"
                                                            Background="{Binding KeyBrush}"
                                                            BorderBrush="#444" BorderThickness="1"
                                                            ToolTip="{Binding KeyName}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.PaintKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <TextBlock Text="{Binding KeyLabel}" FontSize="7"
                                                                   Foreground="White" Opacity="0.7"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   TextWrapping="NoWrap"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Keyboard effect engine. Rendered by the keyboard itself: one frame is sent and the
                     device animates it with OmenCore closed. Shown only where a backend can reach it. -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16"
                        DataContext="{Binding DeviceLighting}"
                        Visibility="{Binding SupportsDeviceEffects, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.LightingView_KeyboardEffects}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static loc:Strings.LightingView_RunByTheKeyboardSOwnControllerTheseKeepRun}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <WrapPanel Margin="0,0,0,12">
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_Effect}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox Width="160" Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding Effects}"
                                          SelectedItem="{Binding SelectedEffect, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_Theme}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox Width="120" Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding Themes}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                          IsEnabled="{Binding UseCustomColors, Converter={StaticResource InverseBooleanConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_Speed}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox Width="100" Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FxNameDisplay}}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_Direction}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox Width="130" Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FxNameDisplay}}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox Content="{x:Static loc:Strings.LightingView_CustomColours}" IsChecked="{Binding UseCustomColors, Mode=TwoWay}"
                                      Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                      Margin="0,0,16,0"/>
                            <!-- Swatch is the picker button, matching the per-key editor. The hex
                                 box stays for typing an exact value; clicking the colour is the
                                 gesture people try first. -->
                            <Button Command="{Binding PickPrimaryColorCommand}" Cursor="Hand"
                                    Padding="0" BorderThickness="0" Background="Transparent"
                                    Margin="0,0,6,0" IsEnabled="{Binding UseCustomColors}"
                                    ToolTip="{x:Static loc:Strings.LightingView_ChooseTheFirstColour}"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_ChooseTheFirstCustomEffectColour}">
                                <Border Width="26" Height="26" CornerRadius="4"
                                        Background="{Binding PrimaryColorBrush}"
                                        BorderBrush="#666" BorderThickness="1"/>
                            </Button>
                            <TextBox Width="80" Margin="0,0,12,0" MaxLength="7"
                                     Text="{Binding PrimaryColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseCustomColors}"/>

                            <Button Command="{Binding PickSecondaryColorCommand}" Cursor="Hand"
                                    Padding="0" BorderThickness="0" Background="Transparent"
                                    Margin="0,0,6,0" IsEnabled="{Binding UseCustomColors}"
                                    ToolTip="{x:Static loc:Strings.LightingView_ChooseTheSecondColour}"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_ChooseTheSecondCustomEffectColour}">
                                <Border Width="26" Height="26" CornerRadius="4"
                                        Background="{Binding SecondaryColorBrush}"
                                        BorderBrush="#666" BorderThickness="1"/>
                            </Button>
                            <TextBox Width="80" Margin="0,0,16,0" MaxLength="7"
                                     Text="{Binding SecondaryColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseCustomColors}"/>
                            <Button Content="{x:Static loc:Strings.LightingView_ApplyEffect}" Style="{StaticResource ModernButton}" Padding="16,6"
                                    Command="{Binding ApplyEffectCommand}" Margin="0,0,8,0"/>
                            <Button Content="{x:Static loc:Strings.LightingView_WhatSOnItNow}" Style="{StaticResource ModernButton}" Padding="12,6"
                                    Command="{Binding ReadEffectCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding EffectAdvice}" FontSize="11" Foreground="#E0A030"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Status}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- The keyboard's own Fn+1 / Fn+2 profile cycle.
                     Same capability as the card above, but the profiles live in the keyboard and are
                     recalled by its own keys - so this is the one part of OmenCore whose result
                     outlives the install. Shown wherever effects are, since it is the same MCU. -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16"
                        DataContext="{Binding DeviceLighting}"
                        Visibility="{Binding SupportsDeviceEffects, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.LightingView_Fn1Fn2Cycle}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static loc:Strings.LightingView_TheKeyboardRemembersAListOfEffectsAndSteps}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="{x:Static loc:Strings.LightingView_AddToCycle}" Style="{StaticResource ModernButton}" Padding="16,6"
                                    Command="{Binding StageCurrentEffectCommand}" Margin="0,0,8,0"
                                    ToolTip="{x:Static loc:Strings.LightingView_StageTheEffectColoursSpeedAndDirectionSetA}"/>
                            <Button Content="{x:Static loc:Strings.LightingView_WriteToKeyboard}" Style="{StaticResource ModernButton}" Padding="16,6"
                                    Command="{Binding WriteFnCycleCommand}"
                                    ToolTip="{x:Static loc:Strings.LightingView_SendEveryStagedProfileToTheKeyboard}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding FnCycleEmptyHint}" FontSize="12" FontStyle="Italic"
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding FnCycleEmptyHint, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                        <ItemsControl ItemsSource="{Binding FnCycleSlots}" Margin="0,0,0,8"
                                      Visibility="{Binding HasFnCycleSlots, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E24" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4"
                                                    Background="{Binding SwatchBrush}" BorderBrush="#666"
                                                    BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- IsChecked is one-way: the view model owns which slot is
                                                 active and clears the others, so the radios cannot get
                                                 into a state where two look selected. -->
                                            <RadioButton Grid.Column="2" Content="{x:Static loc:Strings.LightingView_Showing}" VerticalAlignment="Center"
                                                         Margin="0,0,12,0" FontSize="11"
                                                         Foreground="{StaticResource TextSecondaryBrush}"
                                                         IsChecked="{Binding IsActive, Mode=OneWay}"
                                                         Command="{Binding DataContext.MakeFnSlotActiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         CommandParameter="{Binding}"
                                                         ToolTip="{x:Static loc:Strings.LightingView_LeaveTheKeyboardShowingThisOneAfterWriting}"/>

                                            <Button Grid.Column="3" Content="{x:Static loc:Strings.BloatwareManagerView_Remove}" Padding="10,4" FontSize="11"
                                                    Style="{StaticResource ModernButton}"
                                                    Command="{Binding DataContext.RemoveFnSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{x:Static loc:Strings.LightingView_TakeThisOffTheListItStaysOnTheKeyboard}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding FnCycleAdvice}" FontSize="11" Foreground="#E0A030"
                                   TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding FnCycleAdvice, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding FnCycleLimitation}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding FnCycleStatus}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Light bar. A different device on a different transport, so a separate card. -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16"
                        DataContext="{Binding DeviceLighting}"
                        Visibility="{Binding IsLightBarAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.DiagnosticsView_LightBar}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static loc:Strings.LightingView_TheStripOnTheFrontOfTheChassisFourZonesLef}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{x:Static loc:Strings.LightingView_Colour}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Command="{Binding PickBarColorCommand}" Cursor="Hand"
                                    Padding="0" BorderThickness="0" Background="Transparent"
                                    Margin="0,0,6,0" ToolTip="{x:Static loc:Strings.KeyboardMapEditor_ChooseAColour}"
                                    AutomationProperties.Name="{x:Static loc:Strings.LightingView_ChooseTheLightBarColour}">
                                <Border Width="26" Height="26" CornerRadius="4"
                                        Background="{Binding BarColorBrush}"
                                        BorderBrush="#666" BorderThickness="1"/>
                            </Button>
                            <TextBox Width="80" Margin="0,0,16,0" MaxLength="7"
                                     Text="{Binding BarColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="{x:Static loc:Strings.LightingView_ApplyColour}" Style="{StaticResource ModernButton}" Padding="14,6"
                                    Command="{Binding ApplyLightBarColorCommand}" Margin="0,0,8,0"/>
                            <Button Content="{x:Static loc:Strings.LightingView_Off}" Style="{StaticResource ModernButton}" Padding="14,6"
                                    Command="{Binding LightBarOffCommand}"/>
                        </StackPanel>

                        <!-- Brightness and animations are WMI-only, so they are hidden rather than
                             shown disabled when OmenCore is not elevated. -->
                        <StackPanel Visibility="{Binding SupportsLightBarEffects, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{x:Static loc:Strings.LightingView_Brightness}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider Width="160" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                        Value="{Binding BarBrightness, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding BarBrightness}" FontSize="12" Width="34"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox Width="140" Style="{StaticResource ModernComboBox}" Margin="16,0,8,0"
                                          ItemsSource="{Binding LightBarEffects}"
                                          SelectedItem="{Binding SelectedBarEffect, Mode=TwoWay}"/>
                                <Button Content="{x:Static loc:Strings.LightingView_RunAnimation}" Style="{StaticResource ModernButton}" Padding="14,6"
                                        Command="{Binding ApplyLightBarEffectCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding LightBarLimitation}" FontSize="11" Foreground="#E0A030"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding BarStatus}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Advanced Lighting Effects -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.LightingView_AdvancedLightingEffects}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <!-- Temperature-Responsive Lighting -->
                        <Border Background="{StaticResource SurfaceDarkBrush}"
                                CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.LightingView_TemperatureResponsiveLighting}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Static loc:Strings.LightingView_KeyboardLightBarAndRgbDevicesChangeColorBa}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding TemperatureResponsiveLightingEnabled, Mode=TwoWay}"
                                              Style="{StaticResource ModernToggleButton}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Static loc:Strings.LightingView_EnableTemperatureResponsiveLighting}"/>
                            </Grid>
                        </Border>

                        <!-- Temperature Thresholds -->
                        <Border Background="{StaticResource SurfaceMediumBrush}"
                                CornerRadius="8" Padding="16" Margin="0,0,0,12"
                                Visibility="{Binding TemperatureResponsiveLightingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.LightingView_TemperatureThresholdsC}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{x:Static loc:Strings.BloatwareManagerView_Low}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBox Text="{Binding CpuTempThresholdLow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="4,0">
                                        <TextBlock Text="{x:Static loc:Strings.LightingView_Medium}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBox Text="{Binding CpuTempThresholdMedium, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="{x:Static loc:Strings.BloatwareManagerView_High}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBox Text="{Binding CpuTempThresholdHigh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Color Pickers for Temperature Levels -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{Binding TempLowColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            CornerRadius="6" Padding="8" Margin="0,0,8,0" Cursor="Hand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Static loc:Strings.LightingView_LowTemp}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding TempLowColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" FontSize="10" Margin="0,4,0,0" Width="70"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{Binding TempMediumColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            CornerRadius="6" Padding="8" Margin="4,0" Cursor="Hand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Static loc:Strings.LightingView_MediumTemp}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding TempMediumColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" FontSize="10" Margin="0,4,0,0" Width="70"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{Binding TempHighColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            CornerRadius="6" Padding="8" Margin="8,0,0,0" Cursor="Hand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Static loc:Strings.LightingView_HighTemp}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding TempHighColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" FontSize="10" Margin="0,4,0,0" Width="70"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Performance Mode Synced Lighting -->
                        <Border Background="{StaticResource SurfaceDarkBrush}"
                                CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.LightingView_PerformanceModeSyncedLighting}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Static loc:Strings.LightingView_KeyboardLightBarAndRgbDevicesChangeColorBa_2}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding PerformanceModeSyncedLightingEnabled, Mode=TwoWay}"
                                              Style="{StaticResource ModernToggleButton}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Static loc:Strings.LightingView_EnablePerformanceModeSyncedLighting}"/>
                            </Grid>
                        </Border>

                        <!-- Performance Mode Colors -->
                        <Border Background="{StaticResource SurfaceMediumBrush}"
                                CornerRadius="8" Padding="16" Margin="0,0,0,12"
                                Visibility="{Binding PerformanceModeSyncedLightingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.LightingView_PerformanceModeColors}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{Binding BalancedModeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            CornerRadius="6" Padding="8" Margin="0,0,8,0" Cursor="Hand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Static loc:Strings.AdvancedView_Balanced}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding BalancedModeColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" FontSize="10" Margin="0,4,0,0" Width="70"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{Binding PerformanceModeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            CornerRadius="6" Padding="8" Margin="4,0" Cursor="Hand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Static loc:Strings.AdvancedView_Performance}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding PerformanceModeColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" FontSize="10" Margin="0,4,0,0" Width="70"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{Binding QuietModeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            CornerRadius="6" Padding="8" Margin="4,0" Cursor="Hand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Static loc:Strings.AdvancedView_Quiet}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding QuietModeColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" FontSize="10" Margin="0,4,0,0" Width="70"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="{Binding CustomModeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            CornerRadius="6" Padding="8" Margin="8,0,0,0" Cursor="Hand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Static loc:Strings.FanControlView_Custom}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding CustomModeColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" FontSize="10" Margin="0,4,0,0" Width="70"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Throttling Indicators -->
                        <Border Background="{StaticResource SurfaceDarkBrush}"
                                CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.LightingView_ThrottlingIndicators}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Static loc:Strings.LightingView_FlashRedOrangeWhenCpuGpuThermalOrPowerThro}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding ThrottlingIndicatorLightingEnabled, Mode=TwoWay}"
                                              Style="{StaticResource ModernToggleButton}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Static loc:Strings.LightingView_EnableThrottlingIndicatorLighting}"/>
                            </Grid>
                        </Border>

                        <!-- Throttling Color -->
                        <Border Background="{StaticResource SurfaceMediumBrush}"
                                CornerRadius="8" Padding="16" Margin="0,0,0,0"
                                Visibility="{Binding ThrottlingIndicatorLightingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.LightingView_ThrottlingWarningColor}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                <Border Background="{Binding ThrottlingColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        CornerRadius="6" Padding="12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Static loc:Strings.LightingView_ThrottlingAlert}" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding ThrottlingColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" FontSize="10" Margin="12,0,0,0" Width="70"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Keyboard Unavailable Message -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16"
                        Visibility="{Binding IsKeyboardLightingAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.LightingView_HpOmenKeyboard}" FontSize="20" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding KeyboardUnavailableMessage}" 
                                   TextWrapping="Wrap"
                                   FontSize="14" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{x:Static loc:Strings.LightingView_ThisFeatureRequiresASupportedHpOmenLaptopW}" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Macro Profiles (Corsair) -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.LightingView_MacroProfiles}" FontSize="20" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.LightingView_ActiveProfile}" 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding MacroProfiles}"
                                      SelectedItem="{Binding SelectedMacroProfile}"
                                      DisplayMemberPath="ProfileName"
                                      Margin="0,0,12,0"
                                      AutomationProperties.Name="{x:Static loc:Strings.LightingView_MacroProfileSelection}"/>
                            
                            <Button Grid.Column="2" 
                                    Content="{x:Static loc:Strings.LightingView_LoadProfile}" 
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding LoadMacroProfileCommand}"
                                    Padding="16,8"/>
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.LightingView_UseCorsairIcueOrLogitechGHubSoftwareForAdv}" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Loading Overlay -->
        <controls:LoadingOverlay Panel.ZIndex="1000" />
    </Grid>
</UserControl>
