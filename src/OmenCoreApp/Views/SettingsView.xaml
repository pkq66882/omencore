                <!-- Battery Care Settings -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🔋" FontSize="24" 
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.SettingsView_BatteryCare}" FontSize="20" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsView_ExtendBatteryLifespanWithSmartChargeLimiti}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Enable/Disable Charge Limit -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsView_EnableChargeLimit}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsView_StopChargingAtACustomThresholdToPreserveBa}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding BatteryChargeLimitEnabled}"
                                          AutomationProperties.Name="{x:Static loc:Strings.SettingsView_EnableChargeLimit}"/>
                        </Grid>

                        <!-- Charge Threshold Slider (shown when enabled) -->
                        <Border Background="#1A6B4C9A" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                                Visibility="{Binding BatteryChargeLimitEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static loc:Strings.SettingsView_ChargeThreshold}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{x:Static loc:Strings.SettingsView_SetMaximumBatteryChargeLevel}" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider AutomationProperties.Name="{x:Static loc:Strings.SettingsView_BatteryChargeThresholdPercent}" Minimum="60" Maximum="100" 
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding BatteryChargeThresholdPercent}"
                                            Width="80" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BatteryChargeThresholdPercent, StringFormat={}{0}%}" 
                                               FontSize="16" FontWeight="Bold" Width="50" TextAlignment="Right"
                                               Foreground="#81C784"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Info Banner -->
                        <Border Background="#1A4CAF50" CornerRadius="4" Padding="12" Margin="0,0,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run FontWeight="SemiBold" Foreground="#81C784" Text="{x:Static loc:Strings.SettingsView_BatteryTipsTitle}"/>
                                <LineBreak/>
                                • <Run FontWeight="SemiBold">80%</Run><Run Text="{x:Static loc:Strings.SettingsView_BatteryTip80}"/>
                                <LineBreak/>
                                • <Run FontWeight="SemiBold">60-70%</Run><Run Text="{x:Static loc:Strings.SettingsView_BatteryTip6070}"/>
                                <LineBreak/>
                                • <Run FontWeight="SemiBold">100%</Run><Run Text="{x:Static loc:Strings.SettingsView_BatteryTip100}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Fan Hysteresis Settings -->
                <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🌀" FontSize="24" 
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.SettingsView_FanHysteresis}" FontSize="20" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsView_PreventFanSpeedOscillationWithDeadZoneAndD}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Enable -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsView_EnableHysteresis}" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsView_SmoothOutFanSpeedChangesToReduceNoiseFluct}" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          Style="{StaticResource ModernToggleButton}"
                                          IsChecked="{Binding FanHysteresisEnabled}"
                                          AutomationProperties.Name="{x:Static loc:Strings.SettingsView_EnableHysteresis}"/>
                        </Grid>

                        <Border Background="#1A6B4C9A" CornerRadius="8" Padding="16" 
                                IsEnabled="{Binding FanHysteresisEnabled}">
                            <StackPanel>
                                <!-- Dead Zone -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_TemperatureDeadZone}" FontSize="13" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_FansWonTChangeUnlessTempMovesBeyondThis}" FontSize="11" 
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_FanHysteresisDeadZone}" Text="{Binding FanHysteresisDeadZone, StringFormat=F1}" 
                                                 Width="50" Padding="6,4" TextAlignment="Right"/>
                                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="4,0,0,0" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Ramp Up Delay -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_RampUpDelay}" FontSize="13" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_WaitBeforeIncreasingFanSpeed}" FontSize="11" 
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_FanHysteresisRampUpDelay}" Text="{Binding FanHysteresisRampUpDelay, StringFormat=F1}" 
                                                 Width="50" Padding="6,4" TextAlignment="Right"/>
                                        <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Ramp Down Delay -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_RampDownDelay}" FontSize="13" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_WaitBeforeDecreasingFanSpeed}" FontSize="11" 
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_FanHysteresisRampDownDelay}" Text="{Binding FanHysteresisRampDownDelay, StringFormat=F1}" 
                                                 Width="50" Padding="6,4" TextAlignment="Right"/>
                                        <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Thermal Protection Enable/Disable Toggle -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_ThermalProtection}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_AutoBoostFansWhenTempsExceedThresholdInclu}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource ModernToggleButton}"
                                                  IsChecked="{Binding ThermalProtectionEnabled}"
                                                  AutomationProperties.Name="{x:Static loc:Strings.SettingsView_ThermalProtection}"/>
                                </Grid>

                                <!-- Thermal Protection Threshold -->
                                <Grid Margin="0,12,0,0"
                                      IsEnabled="{Binding ThermalProtectionEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_ThermalProtectionThreshold}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_FansRampUpWhenTempsExceedThis7095C}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding ThermalProtectionThreshold, StringFormat=F0}"
                                                 Width="50" Padding="6,4" TextAlignment="Right"
                                                 AutomationProperties.Name="{x:Static loc:Strings.SettingsView_ThermalProtectionRampThresholdInCelsius}"/>
                                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Thermal Emergency Threshold -->
                                <Grid Margin="0,12,0,0"
                                      IsEnabled="{Binding ThermalProtectionEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_EmergencyMaxFanThreshold}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_FansForcedTo100ImmediatelyAboveThis9099CAl}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding ThermalEmergencyThreshold, StringFormat=F0}"
                                                 Width="50" Padding="6,4" TextAlignment="Right"
                                                 AutomationProperties.Name="{x:Static loc:Strings.SettingsView_EmergencyMaxFanThresholdInCelsius}"/>
                                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Max Fan Level Override -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_MaxFanLevelOverride}" FontSize="13" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsView_OverrideAutoDetectedMaxFanLevelSetTo0ForAu}" FontSize="11" 
                                                   Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_MaxFanLevelOverride}" Text="{Binding MaxFanLevelOverride, StringFormat=F0}" 
                                                 Width="50" Padding="6,4" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
