                                                        <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_PriorityLowerNumbersRunFirst}" Grid.Column="3" Text="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource ModernTextBox}" Padding="8,4" Margin="0,0,10,0" ToolTip="{x:Static loc:Strings.SettingsView_LowerNumbersRunFirst}"/>

                                                        <Button AutomationProperties.Name="{x:Static loc:Strings.SettingsView_RemoveAutomationRule}" Grid.Column="4" Content="✕" Style="{StaticResource DangerButton}"
                                                                Width="32" Height="32" Padding="0"
                                                                Command="{Binding DataContext.RemoveAutomationRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsTimeTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_StartTime}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_StartTime}" Text="{Binding StartTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsTimeTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_EndTime}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_EndTime}" Text="{Binding EndTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsBatteryTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_BatteryThreshold}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_BatteryThreshold}" Text="{Binding BatteryThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsBatteryTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_BatteryCondition}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_BatteryCondition}" ItemsSource="{Binding BatteryConditions}" SelectedItem="{Binding BatteryCondition, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernComboBox}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsACPowerTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_AcPowerState}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_AcPowerState}" ItemsSource="{Binding AcPowerStates}" SelectedItem="{Binding AcPowerState, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernComboBox}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsTemperatureTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_TemperatureThresholdC}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_TemperatureThreshold}" Text="{Binding TemperatureThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsTemperatureTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_TemperatureCondition}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_TemperatureCondition}" ItemsSource="{Binding TemperatureConditions}" SelectedItem="{Binding TemperatureCondition, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernComboBox}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2"
                                                                    Visibility="{Binding IsTemperatureTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_Sensor}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_TemperatureSensor}" ItemsSource="{Binding TemperatureSensors}" SelectedItem="{Binding TemperatureSensor, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernComboBox}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsIdleTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_IdleMinutes}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_IdleMinutes}" Text="{Binding IdleMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsProcessTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_ProcessNameEGGameExe}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_ProcessName}" Text="{Binding ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsWiFiTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_WifiNetworkNameSsid}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_WifiSsid}" Text="{Binding WiFiSSID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsLidTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_LidState}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_LidState}" ItemsSource="{Binding LidStates}" SelectedItem="{Binding LidState, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernComboBox}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_FanPresetAction}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_FanPresetAction}" ItemsSource="{Binding FanPresetOptions}" SelectedItem="{Binding FanPreset, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernComboBox}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsView_PerformanceModeAction}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox AutomationProperties.Name="{x:Static loc:Strings.SettingsView_PerformanceModeAction}" ItemsSource="{Binding PerformanceModeOptions}" SelectedItem="{Binding PerformanceMode, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernComboBox}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Padding="10,8" CornerRadius="6" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1AF44336"/>
                                                                <Setter Property="BorderBrush" Value="#33F44336"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ValidationMessage}" Value="Ready">
                                                                        <Setter Property="Background" Value="#1A4CAF50"/>
                                                                        <Setter Property="BorderBrush" Value="#334CAF50"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ValidationMessage}" FontSize="11" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ValidationMessage}" Value="Ready">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
        
        <!-- Loading Overlay -->
        <controls:LoadingOverlay Grid.RowSpan="3" Panel.ZIndex="1000" />
    </Grid>
</UserControl>
