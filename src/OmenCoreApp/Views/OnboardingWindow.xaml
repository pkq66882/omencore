<Window x:Class="OmenCore.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:OmenCore.Localization"
        Title="{x:Static loc:Strings.OnboardingWindow_WelcomeToOmencore}"
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundDarkBrush}"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundDarkBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceMediumBrush}" CornerRadius="12,12,0,0" Padding="20,14" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconLighting}" Width="20" Height="20" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_OmencoreSetup}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextTertiaryBrush}"
                            FontSize="14" Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Step indicator -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                        VerticalAlignment="Bottom">
                <!-- Step dots rendered by code-behind with x:Name -->
            </StackPanel>

            <!-- Page content -->
            <Grid Grid.Row="1" Margin="32,24,32,8">

                <!-- Page 1: Welcome -->
                <StackPanel x:Name="Page1" Visibility="Visible">
                    <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_Welcome}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24">
                        <Run Text="{x:Static loc:Strings.OnboardingWindow_OmencoreIsACommunityBuiltFanLightingAndPer}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{x:Static loc:Strings.OnboardingWindow_ThisQuickSetupTakesAbout30SecondsAndHelpsO}"/>
                    </TextBlock>

                    <Border Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_WhatOmencoreDoes}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Path Data="{StaticResource IconFan}" Width="16" Height="16" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_CustomFanCurvesWithTemperatureBasedControl}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Path Data="{StaticResource IconLighting}" Width="16" Height="16" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_N4ZoneRgbKeyboardLightingControl}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Path Data="{StaticResource IconPerformance}" Width="16" Height="16" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_PerformanceAndPowerModeSwitching}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconMonitoring}" Width="16" Height="16" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_RealTimeCpuGpuTemperatureAndLoadMonitoring}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page 2: Hardware Detection -->
                <StackPanel x:Name="Page2" Visibility="Collapsed">
                    <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_YourHardware}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_OmencoreDetectedTheFollowingOnYourSystem}" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                    <Border Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_FanControlBackend}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="FanBackendDot" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FanBackendText" Text="{x:Static loc:Strings.OnboardingWindow_Detecting}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_MonitoringSource}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="MonitoringDot" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MonitoringText" Text="{x:Static loc:Strings.OnboardingWindow_Detecting}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfaceCard}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_PawnioDriver}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DriverDot" Width="10" Height="10" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DriverText" Text="{x:Static loc:Strings.OnboardingWindow_Checking}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page 3: Quick Start -->
                <StackPanel x:Name="Page3" Visibility="Collapsed">
                    <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_QuickStart}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_AllSet}" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                    <Border Style="{StaticResource SurfaceCard}" Padding="16" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFan}" Width="24" Height="24" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_ApplyAFanPreset}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_HeadToFanControlAndTryTheAutoOrGamingPrese}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfaceCard}" Padding="16" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLighting}" Width="24" Height="24" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_CustomiseYourLighting}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_OpenLightingAndClickAnyKeyboardZoneToChang}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfaceCard}" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}" Width="24" Height="24" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_ConfigureSettings}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.OnboardingWindow_EnableStartWithWindowsSetAPollingIntervalA}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Step dots + navigation footer -->
            <Grid Grid.Row="2" Margin="32,8,32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Step indicators -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12">
                    <Ellipse x:Name="Dot1" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="4,0"/>
                    <Ellipse x:Name="Dot2" Width="10" Height="10" Fill="{StaticResource SurfaceHighlightBrush}" Margin="4,0"/>
                    <Ellipse x:Name="Dot3" Width="10" Height="10" Fill="{StaticResource SurfaceHighlightBrush}" Margin="4,0"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <!-- MinWidth instead of fixed Width: "下一步 →" (99px incl. padding) overflows a
                         fixed 90px and the arrowhead gets clipped, rendering as "下一步-". English
                         still lays out identically because it fits inside the minimum. -->
                    <Button x:Name="BackButton" Content="{x:Static loc:Strings.OnboardingWindow_Back}" Style="{StaticResource SecondaryButton}"
                            MinWidth="90" Margin="0,0,8,0" Click="BackButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="NextButton" Content="{x:Static loc:Strings.OnboardingWindow_Next}" Style="{StaticResource ModernButton}"
                            MinWidth="90" Margin="0,0,8,0" Click="NextButton_Click"/>
                    <Button x:Name="FinishButton" Content="{x:Static loc:Strings.OnboardingWindow_GetStarted}" Style="{StaticResource ModernButton}"
                            MinWidth="110" Click="FinishButton_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
