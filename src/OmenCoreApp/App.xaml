<Application x:Class="OmenCore.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             xmlns:controls="clr-namespace:OmenCore.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OmenCore;component/Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Legacy compatibility -->
            <Color x:Key="OmenRed">#FFE6002E</Color>
            <Color x:Key="OmenGray">#FF1D1F27</Color>
            <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource OmenGray}" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:InverseBooleanConverter x:Key="InverseBooleanConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:IntGreaterThanZeroToVisibilityConverter x:Key="IntGreaterThanZeroToVisibilityConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:IntZeroToVisibilityConverter x:Key="IntZeroToVisibilityConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:TemperatureToColorConverter x:Key="TemperatureToColorConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:LoadToColorConverter x:Key="LoadToColorConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:BoolToYesNoConverter x:Key="BoolToYesNo" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:BoolToColorConverter x:Key="BoolToColor" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:HexToBrushConverter x:Key="HexToBrushConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:PowerToTotalConverter x:Key="PowerToTotalConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:FanSpeedConverter x:Key="FanSpeedConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:LatestFanSpeedConverter x:Key="LatestFanSpeedConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:ZeroDoubleToPlaceholderConverter x:Key="ZeroDoubleToPlaceholderConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:ModeDisplayNameConverter x:Key="ModeDisplayNameConverter" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:SceneDisplayNameConverter x:Key="SceneDisplayName" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:AudioVizModeDisplayConverter x:Key="AudioVizModeDisplay" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:FxNameDisplayConverter x:Key="FxNameDisplay" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:RiskLevelDisplayConverter x:Key="RiskLevelDisplay" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:ModelNameDisplayConverter x:Key="ModelNameDisplay" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:GpuSwitchModeDisplayConverter x:Key="GpuSwitchModeDisplay" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:GpuBoostLevelDisplayConverter x:Key="GpuBoostLevelDisplay" xmlns:local="clr-namespace:OmenCore.Utils" />
            <DataTemplate x:Key="GpuSwitchModeItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource GpuSwitchModeDisplay}}"/>
            </DataTemplate>
            <DataTemplate x:Key="GpuBoostLevelItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource GpuBoostLevelDisplay}}"/>
            </DataTemplate>
            <local:SettingsTokenDisplayConverter x:Key="SettingsTokenDisplay" xmlns:local="clr-namespace:OmenCore.Utils" />
            <local:MinutesDisplayConverter x:Key="MinutesDisplay" xmlns:local="clr-namespace:OmenCore.Utils" />
            <DataTemplate x:Key="SettingsTokenItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}}"/>
            </DataTemplate>
            <DataTemplate x:Key="FanPresetItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}, ConverterParameter=FanPreset}"/>
            </DataTemplate>
            <DataTemplate x:Key="PerfModeItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}, ConverterParameter=PerfMode}"/>
            </DataTemplate>
            <DataTemplate x:Key="KeyboardProfileItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}, ConverterParameter=KeyboardProfile}"/>
            </DataTemplate>
            <DataTemplate x:Key="PeripheralProfileItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}, ConverterParameter=Peripheral}"/>
            </DataTemplate>
            <DataTemplate x:Key="CleanProfileItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}, ConverterParameter=CleanProfile}"/>
            </DataTemplate>
            <DataTemplate x:Key="SpeedItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}, ConverterParameter=Speed}"/>
            </DataTemplate>
            <DataTemplate x:Key="BatteryConditionItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}, ConverterParameter=BatteryCondition}"/>
            </DataTemplate>
            <DataTemplate x:Key="AcPowerItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}, ConverterParameter=AcPower}"/>
            </DataTemplate>
            <DataTemplate x:Key="LidItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}, ConverterParameter=Lid}"/>
            </DataTemplate>
            <DataTemplate x:Key="MaxAutoReturnItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}, ConverterParameter=MaxAutoReturn}"/>
            </DataTemplate>
            <DataTemplate x:Key="RgbSurfaceItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource SettingsTokenDisplay}, ConverterParameter=RgbSurface}"/>
            </DataTemplate>
            <DataTemplate x:Key="MinutesItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource MinutesDisplay}}"/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
